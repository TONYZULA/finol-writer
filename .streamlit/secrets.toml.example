# ============================================================
# Streamlit Secrets – copy to .streamlit/secrets.toml
# Add your actual keys in Streamlit Cloud → Settings → Secrets
# ============================================================

# ── AIML API (3 keys → rolling fallback) ────────────────────
# Get keys at: https://aimlapi.com
AIML_API_KEY_1 = "your-aiml-key-1-here"   # auto account
AIML_API_KEY_2 = "your-aiml-key-2-here"   # muli account
AIML_API_KEY_3 = "your-aiml-key-3-here"   # harsi account

# ── Google Gemini (2 keys → rolling fallback) ────────────────
# Get keys at: https://aistudio.google.com/app/apikeys
GOOGLE_API_KEY   = "your-gemini-key-1-here"
GOOGLE_API_KEY_2 = "your-gemini-key-2-here"

# ── OpenRouter (optional extra fallback) ─────────────────────
# OPENROUTER_API_KEY = "sk-or-v1-..."

# ── Required services ────────────────────────────────────────
TAVILY_API_KEY    = "your-tavily-key-here"
TEMPLATED_API_KEY = "your-templated-key-here"
