# ============================================================
# Streamlit Secrets – copy to .streamlit/secrets.toml
# Add your actual keys in Streamlit Cloud → Settings → Secrets
# ============================================================

# ── OpenRouter API (required for AI draft generation) ───────
# Get keys at: https://openrouter.ai/keys
OPENROUTER_API_KEY = "sk-or-v1-your-openrouter-api-key"

# ── Required services ────────────────────────────────────────
TAVILY_API_KEY    = "your-tavily-key-here"
# Copy this content to Streamlit Cloud Secrets
# Go to: https://share.streamlit.io → Your App → Settings → Secrets
